#include <wordexp.h>
#include <unistd.h>
#include <stdio.h>
#include <string.h>
#include <limits.h>
#include <stdint.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <signal.h>
#include <errno.h>
#include <fcntl.h>
#include "pthread_impl.h"

static void reap(pid_t pid)
{
	int status;
	while (waitpid(pid, &status, 0) < 0 && errno == EINTR);
}

static char *getword(FILE *f)
{
	char *s = 0;
	return getdelim(&s, (size_t [1]){0}, 0, f) < 0 ? 0 : s;
}

static int is_wc(int c)
{
	return c == '_' || (c >= '0' && c <= '9') ||
		(c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

/* ANSI-C $'...' unit at s (s[0]=='$', s[1]=='\'').
 * *len set past the closing quote.
 * Returns 1 if the content holds "$(" or backquote, 2 if empty,
 * 0 if clean, -1 if unterminated. */
static int ansi_unit(const char *s, size_t *len)
{
	size_t i = 2;
	int dirty = 0, empty = 1;
	for (;;) {
		if (s[i] == '\\') {
			if (!s[i+1]) return -1;
			empty = 0;
			i += 2;
			continue;
		}
		if (s[i] == '\'') {
			*len = i+1;
			if (empty) return 2;
			return dirty;
		}
		if (!s[i]) return -1;
		empty = 0;
		if (s[i] == '$' && s[i+1] == '(') dirty = 1;
		if (s[i] == '`') dirty = 1;
		i++;
	}
}

static int brace_unit(const char *s, size_t *len, int in_arith, int depth);
static int arith_ok(const char *p, size_t *len);

/* Bound on nested ${...} recursion: the scanner recurses per nesting
 * level, so unbounded input depth would exhaust the stack. Legitimate
 * expansions nest single digits deep; anything beyond this is treated
 * as too complex to verify safe (fail closed, like upstream). */
#define BRACE_MAXDEPTH 64

/* ${...} unit at s (s[0]=='$', s[1]=='{'), with fresh quote state
 * (globs/words inside are parsed as their own context).
 * in_arith: single-quote does not suppress cmdsub detection.
 * *len set past the closing '}'.
 * Returns 0 clean, 1 dirty (command substitution inside),
 * 2 malformed or too deeply nested, -1 to fall back to legacy
 * handling (bare brace or unbalanced: the caller reverts to
 * historical behaviour). */
static int brace_unit(const char *s, size_t *len, int in_arith, int depth)
{
	size_t i = 2;
	int brdepth = 1, sq = 0, dq = 0;
	if (depth > BRACE_MAXDEPTH)
		return 2;
	while (s[i]) {
		char c = s[i];
		if (c == '\\') {
			if (!s[i+1]) return -2;
			i += 2;
			continue;
		}
		if (c == '\'' && !dq) {
			sq ^= 1;
			i++;
			continue;
		}
		if (c == '"' && !sq) {
			dq ^= 1;
			i++;
			continue;
		}
		if (c == '$' && s[i+1] == '\'' && !sq) {
			size_t al = 0;
			int a = ansi_unit(s+i, &al);
			if (a < 0) return -2;
			if (a == 2) return 2;
			if (a) return 1;
			i += al;
			continue;
		}
		if (c == '{' && !sq) return -1;
		if (c == '$' && s[i+1] == '{' && !sq) {
			size_t nl = 0;
			int n = brace_unit(s+i, &nl, in_arith, depth+1);
			if (n < 0) return n;
			if (n == 2) return 2;
			if (n) return 1;
			i += nl;
			continue;
		}
		if (c == '$' && s[i+1] == '(' && s[i+2] == '(' && !sq) {
			size_t al = 0;
			int ar = arith_ok(s+i+1, &al);
			if (ar == 0) {
				i += 1 + al;
				continue;
			}
			/* Invalid arithmetic reads as literal text here;
			 * keep scanning it (an inner $( or backquote still
			 * trips the rules below, so nothing executable
			 * slips through). */
			i++;
			continue;
		}
		if (c == '$' && s[i+1] == '(') {
			if (s[i+2] != '(') {
				if (in_arith || !sq) return 1;
				i += 2;
				continue;
			}
		}
		if (c == '`' && (in_arith || !sq)) return 1;
		if (c == '}' && !sq) {
			if (--brdepth == 0) {
				*len = i+1;
				return 0;
			}
			i++;
			continue;
		}
		i++;
	}
	return -2;
}

/* Validate "((...))" arithmetic at p (p[0]=='(', p[1]=='(').
 * *len set through the final ')' on success.
 * Returns 0 valid, 1 blocked (caller: WRDE_CMDSUB),
 * 2 malformed (caller: WRDE_SYNTAX). */
static int arith_ok(const char *p, size_t *len)
{
	size_t i = 0;
	int depth = 0, bdepth = 0, last = 0;
	while (p[i]) {
		char c = p[i];
		if (c == '(') {
			depth++;
			last = 0;
			i++;
			continue;
		}
		if (c == '[') {
			bdepth++;
			last = 0;
			i++;
			continue;
		}
		if (c == ')') {
			if (last != 1) return 2;
			if (--depth == 0) {
				*len = i+1;
				return 0;
			}
			last = 1;
			i++;
			continue;
		}
		if (c == ']') {
			if (bdepth == 0 || last != 1) return 1;
			bdepth--;
			last = 1;
			i++;
			continue;
		}
		if (c == ' ' || c == '\t') {
			i++;
			continue;
		}
		if (c == '\'')
			return 1;
		if (c == '"' || c == '\\' || c == '`' || c == ';' ||
		    c == '\n') return 1;
		if (c == '#') {
			/* base notation 16#ff needs a digit before # */
			if (i > 0 && p[i-1] >= '0' && p[i-1] <= '9') {
				while (is_wc(p[i+1]) || p[i+1] == '@')
					i++;
				i++;
				last = 1;
				continue;
			}
			return 2;
		}
		if (c == '$') {
			if (p[i+1] == '\'') {
				size_t al = 0;
				int a = ansi_unit(p+i, &al);
				if (a) return a == 2 ? 2 : 1;
				if (last == 1) return 1;
				last = 1;
				i += al;
				continue;
			}
			if (p[i+1] == '{') {
				size_t bl = 0;
				int b;
				if (last == 1) return 1;
				b = brace_unit(p+i, &bl, 1, 0);
				if (b < 0) return 2;
				if (b) return 1;
				last = 1;
				i += bl;
				continue;
			}
			if (p[i+1] == '(') {
				if (p[i+2] != '(') return 1;
				i++;
				last = 0;
				continue;
			}
			{
				size_t j = i+1;
				if (p[j] == '{' || p[j] == '\'')
					return 1;
				if (is_wc(p[j]) || p[j] == '#' ||
				    p[j] == '?' || p[j] == '-' ||
				    p[j] == '$' || p[j] == '!') {
					if (last == 1) return 1;
					last = 1;
					i++;
					while (is_wc(p[i])) i++;
					continue;
				}
				return 1;
			}
		}
		if (is_wc(c) || c == '.') {
			size_t j = i;
			if (last == 1) return 1;
			while (is_wc(p[j]) || p[j] == '.') j++;
			last = 1;
			i = j;
			continue;
		}
		{
			size_t j = i;
			while (p[j] == '+' || p[j] == '-' || p[j] == '*' ||
			       p[j] == '/' || p[j] == '%' || p[j] == '<' ||
			       p[j] == '>' || p[j] == '&' || p[j] == '|' ||
			       p[j] == '^' || p[j] == '~' || p[j] == '=' ||
			       p[j] == '!' || p[j] == '?' || p[j] == ':' ||
			       p[j] == ',')
				j++;
			if (j == i) return 1;
			if (j - i == 1 && (p[i] == '&' || p[i] == '|'))
				return 1;
			if (last == 1) {
				last = 2;
				i = j;
				continue;
			}
			{
				size_t k = i;
				while (k < j && (p[k] == '+' || p[k] == '-' ||
						 p[k] == '~' || p[k] == '!'))
					k++;
				if (k != j) return 2;
				i = j;
				continue;
			}
		}
	}
	return 2;
}

static int do_wordexp(const char *s, wordexp_t *we, int flags)
{
	size_t i, l;
	int sq=0, dq=0;
	char *w, **tmp;
	int err = 0;
	int null = -1;
	FILE *f;
	size_t wc = 0;
	char **wv = 0;
	int p[2];
	pid_t pid;
	sigset_t set;

	if (flags & WRDE_REUSE) wordfree(we);

	if (flags & WRDE_NOCMD) for (i=0; s[i]; i++) switch (s[i]) {
	case '\\':
		if (!sq && !s[++i]) return WRDE_SYNTAX;
		break;
	case '\'':
		if (!dq) sq^=1;
		break;
	case '"':
		if (!sq) dq^=1;
		break;
	case '(':
	case ')':
	case '\n':
	case '|':
	case '&':
	case ';':
	case '<':
	case '>':
	case '{':
	case '}':
		if (!(sq|dq)) return WRDE_BADCHAR;
		break;
	case '#':
		/* A # starting a word begins a comment; skip to the
		 * end of the line. A newline in command position
		 * still separates commands. A comment running to end
		 * of input simply ends the scan here; execution
		 * proceeds normally (never return success early --
		 * that would skip the shell and leave stale output). */
		if (!sq && !dq &&
		    (i == 0 || strchr(" \t\n;&|()<>", s[i-1]))) {
			while (s[i+1] && s[i+1] != '\n') i++;
			break;
		}
		break;
	case '$':
		if (sq) break;
		if (s[i+1] == '\'') {
			/* ANSI-C $'...' quote: consume literally (escapes
			 * honoured); flag embedded command substitution. */
			size_t al = 0;
			int a = ansi_unit(s+i, &al);
			if (a < 0 || a == 2) return WRDE_SYNTAX;
			if (a) return WRDE_CMDSUB;
			i += al-1;
			break;
		}
		if (s[i+1] == '{') {
			/* ${...} is parsed as its own word: braces must
			 * balance and no command substitution may hide
			 * inside (single-quotes suppress outside
			 * arithmetic). Unbalanced or bare-brace input
			 * keeps the historical verdicts below. */
			size_t bl = 0;
			int b = brace_unit(s+i, &bl, 0, 0);
			if (b == 1) return WRDE_CMDSUB;
			if (b == 2 || b == -2) return WRDE_SYNTAX;
			if (b == 0) {
				i += bl-1;
				break;
			}
			break;
		}
		if (s[i+1] == '(' && s[i+2] == '(') {
			/* Arithmetic is allowed, but only when it really
			 * is arithmetic: validate the token stream.
			 * Anything else is treated as the command
			 * substitution the shell would parse it as. */
			size_t al = 0;
			int ar = arith_ok(s+i+1, &al);
			if (ar == 1) return WRDE_CMDSUB;
			if (ar == 2) return WRDE_SYNTAX;
			i += al;
			break;
		} else if (s[i+1] != '(') break;
	case '`':
		if (sq) break;
		return WRDE_CMDSUB;
	}

	if (flags & WRDE_APPEND) {
		wc = we->we_wordc;
		wv = we->we_wordv;
	}

	i = wc;
	if (flags & WRDE_DOOFFS) {
		if (we->we_offs > SIZE_MAX/sizeof(void *)/4)
			goto nospace;
		i += we->we_offs;
	} else {
		we->we_offs = 0;
	}

	if (pipe2(p, O_CLOEXEC) < 0) goto nospace;
	if (!(flags & WRDE_SHOWERR)) {
		null = open("/dev/null", O_WRONLY|O_CLOEXEC);
		if (null < 0) goto nospace;
	}
	__block_all_sigs(&set);
	pid = fork();
	__restore_sigs(&set);
	if (pid < 0) {
		close(p[0]);
		close(p[1]);
		close(null);
		goto nospace;
	}
	if (!pid) {
		if (p[1] == 1) fcntl(1, F_SETFD, 0);
		else dup2(p[1], 1);
		if (null == 2) fcntl(2, F_SETFD, 0);
		else dup2(null, 2);
		execl("/bin/sh", "sh", "-c",
			"eval \"printf %s\\\\\\\\0 x $1\"",
			"sh", s, (char *)0);
		_exit(1);
	}
	close(p[1]);
	close(null);
	
	f = fdopen(p[0], "r");
	if (!f) {
		close(p[0]);
		kill(pid, SIGKILL);
		reap(pid);
		goto nospace;
	}

	l = wv ? i+1 : 0;

	free(getword(f));
	if (feof(f)) {
		fclose(f);
		reap(pid);
		return WRDE_SYNTAX;
	}

	while ((w = getword(f))) {
		if (i+1 >= l) {
			l += l/2+10;
			tmp = realloc(wv, l*sizeof(char *));
			if (!tmp) {
				free(w);
				break;
			}
			wv = tmp;
		}
		wv[i++] = w;
		wv[i] = 0;
	}
	if (!feof(f)) err = WRDE_NOSPACE;

	fclose(f);
	reap(pid);

	if (!wv) wv = calloc(i+1, sizeof *wv);

	we->we_wordv = wv;
	we->we_wordc = i;

	if (flags & WRDE_DOOFFS) {
		if (wv) for (i=we->we_offs; i; i--)
			we->we_wordv[i-1] = 0;
		we->we_wordc -= we->we_offs;
	}
	return err;

nospace:
	if (!(flags & WRDE_APPEND)) {
		we->we_wordc = 0;
		we->we_wordv = 0;
	}
	return WRDE_NOSPACE;
}

int wordexp(const char *restrict s, wordexp_t *restrict we, int flags)
{
	int r, cs;
	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cs);
	r = do_wordexp(s, we, flags);
	pthread_setcancelstate(cs, 0);
	return r;
}

void wordfree(wordexp_t *we)
{
	size_t i;
	if (!we->we_wordv) return;
	for (i=0; i<we->we_wordc; i++) free(we->we_wordv[we->we_offs+i]);
	free(we->we_wordv);
	we->we_wordv = 0;
	we->we_wordc = 0;
}
